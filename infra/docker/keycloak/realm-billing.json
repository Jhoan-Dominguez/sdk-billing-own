{
  "realm": "billing",
  "displayName": "Registro de compras",
  "enabled": true,
  "loginTheme": "billing",
  "emailTheme": "billing",
  "sslRequired": "external",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "passwordPolicy": "length(8) and notUsername",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "es"
  ],
  "defaultLocale": "es",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrador de la aplicación de compras"
      },
      {
        "name": "customer",
        "description": "Cliente de la aplicación de compras"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-billing",
        "description": "Roles que recibe toda cuenta nueva",
        "composite": true,
        "composites": {
          "realm": [
            "customer",
            "offline_access",
            "uma_authorization"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "billing-app",
      "name": "Registro de compras (Streamlit)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8501/oauth2callback",
        "http://localhost:${APP_PORT}/oauth2callback",
        "http://localhost:8501/configuracion",
        "http://localhost:${APP_PORT}/configuracion"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "billing-admin-api",
      "name": "API de administración de la app (cuenta de servicio)",
      "description": "La app gestiona con ella el perfil, 2FA, sesiones y borrado del propio usuario.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_API_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
