# Copia este archivo a .env y cambia todos los valores "cambiar-*".
# Lo leen docker compose, la app en local (src/billing/settings.py) y scripts/write_secrets.py.

# --- Puertos publicados en el host ---
APP_PORT=8502
DB_PORT=5433
KEYCLOAK_PORT=8180
PGADMIN_PORT=5050

# --- PostgreSQL ---
POSTGRES_USER=billing
POSTGRES_PASSWORD=cambiar-postgres
POSTGRES_DB=billing

# --- pgAdmin ---
PGADMIN_EMAIL=admin@billing.example.com
PGADMIN_PASSWORD=cambiar-pgadmin

# --- Keycloak ---
# Administrador de la consola de Keycloak (realm master)
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=cambiar-keycloak
# Secreto del cliente OIDC billing-app (generar con: python -c "import secrets; print(secrets.token_urlsafe(32))")
KEYCLOAK_CLIENT_SECRET=cambiar-client-secret
# Secreto de la cuenta de servicio billing-admin-api (configuración de cuenta en la app)
KEYCLOAK_ADMIN_API_SECRET=cambiar-admin-api-secret
# Contraseñas de desarrollo de los usuarios del realm "billing" (documentadas en README.md;
# solo se aplican al importar el realm). La de cliente es común a los 4 clientes.
BILLING_ADMIN_PASSWORD=Admin-Compras-2026
BILLING_CUSTOMER_PASSWORD=Cliente-Compras-2026

# --- Streamlit (st.login) ---
# Firma la cookie de sesión; cadena aleatoria larga
AUTH_COOKIE_SECRET=cambiar-cookie-secret
# Solo para correr la app fuera de Docker (en Docker lo fija docker-compose.yml)
AUTH_REDIRECT_URI=http://localhost:8501/oauth2callback

# --- Correo saliente (verificación de cuentas y confirmaciones de seguridad) ---
# En desarrollo todo va a Mailpit (http://localhost:8025): no sale a Internet.
# En producción apunta a un SMTP real (p. ej. Amazon SES) y define SMTP_AUTH/USER/PASSWORD.
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
# Servidor SMTP. Vacío = Mailpit (mailpit:1025 en Docker, localhost:MAILPIT_SMTP_PORT en local).
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=no-reply@billing.example.com
SMTP_AUTH=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false

# --- Bandeja de entrada de pruebas (GreenMail: SMTP + IMAP) ---
# Buzones que crea GreenMail (usuario:contraseña@dominio). Se conectan desde
# Configuración → Correo bancario con servidor "greenmail", puerto 3143, sin SSL.
GREENMAIL_SMTP_PORT=3025
GREENMAIL_IMAP_PORT=3143
GREENMAIL_USERS=cliente:Bandeja-Compras-2026@billing.example.com,maria.lopez:Bandeja-Compras-2026@billing.example.com
# Cada cuántos segundos sincroniza el worker los buzones IMAP
BILLING_MAIL_SYNC_INTERVAL=120

# --- Cifrado de secretos guardados (contraseñas IMAP) ---
# Clave Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BILLING_SECRET_KEY=cambiar-secret-key

# --- Agentes LLM (lectura de facturas y notificaciones bancarias) ---
# Proveedor por defecto: anthropic | openai | gemini | ollama | local (sin LLM, solo reglas).
# Vacío = el primero que tenga credenciales (anthropic, openai, gemini) o "local".
# El administrador puede cambiar proveedor y modelo por agente en Configuración → Agentes IA.
BILLING_LLM_PROVIDER=
BILLING_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Opcional: cualquier API compatible con OpenAI (OpenRouter, Groq, Azure, vLLM...)
OPENAI_BASE_URL=
GEMINI_API_KEY=
# Ollama en el host. Vacío = http://localhost:11434/v1 en local y
# http://host.docker.internal:11434/v1 desde los contenedores.
OLLAMA_BASE_URL=
# Razonamiento de los modelos de Ollama (none | low | medium | high); vacío = el del modelo.
OLLAMA_REASONING_EFFORT=none
# Segundos máximos por llamada a un LLM
BILLING_LLM_TIMEOUT=120

# --- Otros ---
# Moneda por defecto de las compras nuevas
BILLING_CURRENCY=USD

# --- Inicio de sesión con Google (opcional) ---
# Ver docker/keycloak/configure-google.sh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
