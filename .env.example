# Copia este archivo a .env y cambia todos los valores "cambiar-*".
# Lo leen docker compose, la app en local (app/config.py) y scripts/write_secrets.py.

# --- Puertos publicados en el host ---
APP_PORT=8502
DB_PORT=5433
KEYCLOAK_PORT=8180
PGADMIN_PORT=5050

# --- PostgreSQL ---
POSTGRES_USER=compras
POSTGRES_PASSWORD=cambiar-postgres
POSTGRES_DB=compras

# --- pgAdmin ---
PGADMIN_EMAIL=admin@compras.example.com
PGADMIN_PASSWORD=cambiar-pgadmin

# --- Keycloak ---
# Administrador de la consola de Keycloak (realm master)
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=cambiar-keycloak
# Secreto del cliente OIDC compras-app (generar con: python -c "import secrets; print(secrets.token_urlsafe(32))")
KEYCLOAK_CLIENT_SECRET=cambiar-client-secret
# Secreto de la cuenta de servicio compras-admin-api (configuración de cuenta en la app)
KEYCLOAK_ADMIN_API_SECRET=cambiar-admin-api-secret
# Contraseñas de desarrollo de los usuarios del realm "compras" (documentadas en README.md;
# solo se aplican al importar el realm). La de cliente es común a los 4 clientes.
COMPRAS_ADMIN_PASSWORD=Admin-Compras-2026
COMPRAS_CLIENTE_PASSWORD=Cliente-Compras-2026

# --- Streamlit (st.login) ---
# Firma la cookie de sesión; cadena aleatoria larga
AUTH_COOKIE_SECRET=cambiar-cookie-secret
# Solo para correr la app fuera de Docker (en Docker lo fija docker-compose.yml)
AUTH_REDIRECT_URI=http://localhost:8501/oauth2callback

# --- Extracción de facturas (opcional) ---
ANTHROPIC_API_KEY=
COMPRAS_EXTRACTOR=
COMPRAS_MONEDA=USD

# --- Inicio de sesión con Google (opcional) ---
# Ver docker/keycloak/configure-google.sh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
